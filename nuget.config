<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bloomberg-blpapi-release" value="https://nuget.blpapi.bloomberg.com/releases/v3/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <bloomberg-blpapi-release>
      <add key="Username" value="token" />
      <add key="ClearTextPassword" value="download" />
    </bloomberg-blpapi-release>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="bloomberg-blpapi-release">
      <package pattern="Bloomberg.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
